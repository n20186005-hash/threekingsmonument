---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const food = messages.food;
const foodImg = '/gallery/three-kings-monument-5.jpg';
---

<section id="food" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{food.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{food.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{food.lead}</p>

    <div class="mt-10">
      <div class="grid md:grid-cols-3 gap-4">
        {food.museums.map((m) => (
          <div class="rounded-xl bg-teakDeep/60 border border-gold/20 p-5">
            <div class="text-xs uppercase tracking-wider text-gold mb-2">{m.relation}</div>
            <h3 class="font-display text-lg text-ivory mb-2">{m.name}</h3>
            <p class="text-sm text-ivory/75">{m.desc}</p>
          </div>
        ))}
      </div>
      {food.comboTicket && (
        <p class="mt-5 text-sm text-ivory/70 max-w-3xl">{food.comboTicket}</p>
      )}
    </div>

    <blockquote class="mt-12 border-l-4 border-gold pl-5 italic font-display text-2xl text-goldBright max-w-3xl">
      “{food.quote.text}”
      <footer class="text-sm not-italic text-ivory/60 mt-2">— {food.quote.author}</footer>
    </blockquote>
  </div>
</section>
