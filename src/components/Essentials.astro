---
const { messages } = Astro.props;
const e = messages.essentials;
---

<section id="essentials" class="essentials">
  <div class="essentials-inner">
    <h2 class="essentials-heading">{e.heading}</h2>
    <ul class="essentials-grid">
      <li class="essentials-card">
        <span class="e-label">{e.admissionTitle}</span>
        <span class="e-value">{e.admissionValue}</span>
      </li>
      <li class="essentials-card">
        <span class="e-label">{e.locationTitle}</span>
        <span class="e-value">{e.locationValue}</span>
      </li>
      <li class="essentials-card">
        <span class="e-label">{e.accessTitle}</span>
        <span class="e-value">{e.accessValue}</span>
      </li>
      <li class="essentials-card">
        <span class="e-label">{e.highlightsTitle}</span>
        <span class="e-value">{e.highlightsValue}</span>
      </li>
    </ul>
    <a class="essentials-cta" href="#guide">{e.cta} →</a>
  </div>
</section>

<style>
  .essentials {
    background: linear-gradient(180deg, var(--bg, #fff) 0%, var(--surface, #f6f7f9) 100%);
    border-block: 1px solid var(--border, #e7e7ea);
    padding: 2rem 0;
  }
  .essentials-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .essentials-heading {
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, #6b7280);
    margin: 0 0 1rem;
  }
  .essentials-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .essentials-card {
    background: var(--card, #fff);
    border: 1px solid var(--border, #e7e7ea);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .e-label {
    font-size: 0.8rem;
    color: var(--muted, #6b7280);
  }
  .e-value {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text, #1f2430);
  }
  .essentials-cta {
    display: inline-block;
    margin-top: 1.1rem;
    font-weight: 600;
    color: var(--accent, #b45309);
    text-decoration: none;
  }
  .essentials-cta:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .essentials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
