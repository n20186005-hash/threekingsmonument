---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="py-20 bg-teakDeep text-ivory border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/80">{f.intro}</p>

    <div class="mt-6 max-w-4xl rounded-2xl border border-gold/25 bg-teak/50 p-5">
      <p class="text-sm leading-relaxed text-ivory/70">{f.neutrality}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
      {
        f.items.map((item: any) => (
          <div class="flex flex-col rounded-2xl border border-gold/20 bg-teak/50 p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-lg text-goldBright">{item.name}</h3>
              <span class="chip shrink-0 border-gold/40 text-ivory/70">{item.time}</span>
            </div>
            <div class="mt-1 text-xs uppercase tracking-wider text-gold/80">{item.type}</div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ivory/75">{item.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-gold/25 bg-teak/50 p-6">
      <h3 class="font-display text-xl text-goldBright">{f.emergencyTitle}</h3>
      <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {
          f.emergency.map((entry: any) => (
            <li class="metric">
              <div class="text-xs leading-relaxed text-ivory/60">{entry.label}</div>
              <div class="mt-1 font-display text-2xl text-goldBright">{entry.value}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
