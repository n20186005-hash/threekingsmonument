---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';

interface Topic {
  title: string;
  description: string;
  h1: string;
  intro: string;
  sections: { heading: string; body: string }[];
  faqs: { q: string; a: string }[];
  related: { label: string; href: string; desc: string }[];
}
interface Props {
  topic: Topic;
  messages: any;
}
const { topic, messages } = Astro.props;
const base = siteConfig.domain;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Three Kings Monument', item: `${base}/en/` },
    { '@type': 'ListItem', position: 2, name: topic.h1, item: Astro.url.href },
  ],
};
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: topic.h1,
  description: topic.description,
  url: Astro.url.href,
  about: `${base}/#attraction`,
};
---

<BaseLayout
  lang="en"
  title={topic.title}
  description={topic.description}
  faqs={topic.faqs}
  alternateLocales={['en']}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
  <Header lang="en" messages={messages} />
  <main class="topic-page">
    <article>
      <nav class="topic-breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Three Kings Monument</a>
        <span aria-hidden="true">›</span>
        <span>{topic.h1}</span>
      </nav>
      <h1>{topic.h1}</h1>
      <p class="topic-intro">{topic.intro}</p>

      {topic.sections.map((s) => (
        <section class="topic-section">
          <h2>{s.heading}</h2>
          <p>{s.body}</p>
        </section>
      ))}

      <section class="topic-faq" aria-label="Frequently asked questions">
        <h2>Frequently asked questions</h2>
        {topic.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <section class="topic-related" aria-label="Related guides">
        <h2>More guides</h2>
        <ul class="topic-related-grid">
          {topic.related.map((r) => (
            <li>
              <a href={r.href}>{r.label}</a>
              <p>{r.desc}</p>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </main>
  <Footer lang="en" messages={messages} />
</BaseLayout>

<style>
  .topic-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3.5rem;
  }
  .topic-breadcrumb {
    font-size: 0.85rem;
    color: var(--muted, #6b7280);
    margin-bottom: 1rem;
  }
  .topic-breadcrumb a {
    color: var(--accent, #b45309);
    text-decoration: none;
  }
  .topic-page h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--text, #1f2430);
  }
  .topic-intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--muted, #475569);
    margin: 0 0 2rem;
  }
  .topic-section {
    margin: 0 0 1.8rem;
  }
  .topic-section h2 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: var(--text, #1f2430);
  }
  .topic-section p {
    line-height: 1.75;
    margin: 0;
    color: var(--text, #1f2430);
  }
  .topic-faq {
    margin: 2.5rem 0 1rem;
    border-top: 1px solid var(--border, #e7e7ea);
    padding-top: 1.5rem;
  }
  .topic-faq h2 {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .topic-faq details {
    border: 1px solid var(--border, #e7e7ea);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
    background: var(--card, #fff);
  }
  .topic-faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .topic-faq p {
    margin: 0.6rem 0 0;
    line-height: 1.7;
  }
  .topic-related {
    margin-top: 2.5rem;
  }
  .topic-related h2 {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .topic-related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .topic-related-grid li {
    border: 1px solid var(--border, #e7e7ea);
    border-radius: 12px;
    padding: 1rem;
    background: var(--surface, #f6f7f9);
  }
  .topic-related-grid a {
    font-weight: 700;
    color: var(--accent, #b45309);
    text-decoration: none;
  }
  .topic-related-grid p {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--muted, #6b7280);
  }
</style>
