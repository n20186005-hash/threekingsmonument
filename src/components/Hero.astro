---
import { siteConfig } from '../config';
import { getWeather, clock } from '../lib/weather';
import type { Lang } from '../i18n/ui';
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
  /** Shared snapshot from the page; fetched here only as a fallback. */
  weather?: Awaited<ReturnType<typeof getWeather>>;
}
const { lang, messages, weather = null } = Astro.props;
const hero = messages.hero;

const main = hero.titleMain as string;
const accent = hero.titleAccent as string;
const parts = main.split(accent);
const heroImg = '/gallery/three-kings-monument-1.jpg';
const mapsUrl = siteConfig.mapsUrl;
const coordsLabel = siteConfig.coords.label[lang];
// 主视觉图 Alt 语义绑定 — 实体全称 + 城市 + 国家
const entity = siteConfig.entity;
const heroAlt = `${entity.fullName[lang]} - Main view in ${entity.city[lang]}, ${entity.country[lang]}`;

// Rendered on the server so the browser never calls a weather endpoint itself.
const snapshot = weather ?? (await getWeather());
const now = snapshot?.now;
const today = snapshot?.days[0];
const w = messages.weather;
---

<section id="home" class="relative min-h-screen flex items-end overflow-hidden">
  <img src={heroImg} alt={heroAlt} loading="eager" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-t from-teakDeep via-teakDeep/70 to-teak/40"></div>
  <div class="hero-glow absolute inset-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-5 pb-16 pt-28 grid lg:grid-cols-12 gap-10 items-end">
    <div class="lg:col-span-7 text-ivory">
      <p class="font-hand text-gold text-xl md:text-2xl mb-3">{hero.eyebrow}</p>
      <h1 class="font-display font-semibold leading-[1.05] text-5xl md:text-7xl lg:text-8xl text-ivory">
        {parts[0]}<span class="gold-text-bright">{accent}</span>{parts[1] ?? ''}
        <span class="block text-base md:text-xl font-normal tracking-[0.25em] uppercase text-ivory/60 mt-3">
          ({entity.city[lang]} · {entity.country[lang]})
        </span>
      </h1>
      <p class="mt-6 max-w-xl text-ivory/85 text-lg md:text-xl">{hero.subtitle}</p>
      <p class="mt-4 inline-flex w-fit items-center gap-2 text-sm text-goldBright border border-gold/40 rounded-full px-3 py-1">{hero.foundingTag}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#guide" class="inline-flex items-center gap-2 bg-gold text-teak font-semibold px-6 py-3 rounded-full hover:bg-goldBright transition-colors">
          {hero.cta1}
        </a>
        <a href="#food" class="inline-flex items-center gap-2 border border-gold/50 text-ivory px-6 py-3 rounded-full hover:border-goldBright hover:text-goldBright transition-colors">
          {hero.cta2}
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-5 text-sm text-ivory/80">
        <span class="stars text-lg">★ {hero.rating}</span>
        <span>{hero.reviewCount} Google</span>
        <span class="hidden sm:inline text-ivory/40">·</span>
        <span>{coordsLabel}</span>
      </div>

      {/* 评分与评价数来源说明 */}
      <p class="mt-2 text-xs text-ivory/60 leading-relaxed">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-goldBright underline-offset-2 hover:underline">
          {hero.reviewSource}
        </a>
      </p>

      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-goldBright hover:text-gold underline-offset-4 hover:underline text-sm">
        {hero.viewLocation}
      </a>
    </div>

    <!-- live conditions + light planner -->
    <div class="lg:col-span-5">
      <div class="rounded-2xl bg-teak/55 backdrop-blur-md border border-gold/25 p-5 text-ivory shadow-2xl">
        {now && today ? (
          <div>
            <div class="flex items-center justify-between">
              <span class="text-ivory/70 text-sm">{hero.liveWeather}</span>
              <WeatherIcon group={now.group} isDay={now.isDay} class="w-8 h-8 text-goldBright" />
            </div>
            <div class="mt-1 flex items-end gap-3">
              <span class="font-display text-5xl font-semibold text-goldBright">{now.temperature}°</span>
              <div class="pb-1">
                <div class="text-sm">{w.codes[now.group]}</div>
                <div class="text-xs text-ivory/60">
                  {w.feelsLike} {now.feelsLike}° · {w.wind} {now.wind} {w.units.wind}
                </div>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-gold/20">
              <p class="font-hand text-gold text-lg">{hero.plannerTitle}</p>
              <p class="text-xs text-ivory/60 mt-0.5">{hero.plannerNote}</p>
              <div class="mt-3 space-y-2 text-sm">
                <div class="flex justify-between"><span class="text-ivory/70">{hero.goldenHourLabel}</span><span class="font-semibold text-goldBright">07:00 – 08:30</span></div>
                <div class="flex justify-between"><span class="text-ivory/70">{w.sunrise}</span><span class="font-semibold text-goldBright">{clock(today.sunrise)}</span></div>
                <div class="flex justify-between"><span class="text-ivory/70">{w.sunset}</span><span class="font-semibold text-goldBright">{clock(today.sunset)}</span></div>
                <div class="flex justify-between"><span class="text-ivory/70">{hero.crowdWarningLabel}</span><span class="font-semibold text-ivory">{hero.crowdAfter}</span></div>
              </div>
              <p class="text-[11px] text-ivory/50 mt-2">{hero.lightCaption}</p>
            </div>
          </div>
        ) : (
          <p class="text-ivory/80 text-sm">{hero.weatherError}</p>
        )}
      </div>
    </div>
  </div>
</section>
