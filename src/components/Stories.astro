---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.stories;

const badgeClass = (badge: string) =>
  badge === s.badgeHistory
    ? 'border-gold/60 bg-gold/15 text-teak'
    : 'border-burgundy/40 bg-burgundy/5 text-burgundy';
---

<section id="stories" class="py-20 bg-ivoryDim text-ink border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/85">{s.intro}</p>

    <div class="mt-12 space-y-10">
      {
        s.items.map((item: any, index: number) => (
          <article
            class={`grid md:grid-cols-[15rem_1fr] gap-5 md:gap-10 pb-10 ${
              index < s.items.length - 1 ? 'border-b border-gold/25' : ''
            }`}
          >
            <div>
              <span
                class={`inline-block rounded-full border px-3 py-1 text-xs tracking-wide ${badgeClass(item.badge)}`}
              >
                {item.badge}
              </span>
              <div class="mt-3 font-hand text-lg text-gold">{item.era}</div>
            </div>
            <div>
              <h3 class="font-display font-semibold text-xl md:text-2xl text-teak">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink/80">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 max-w-3xl text-xs text-ink/55">{s.sourcesNote}</p>
  </div>
</section>
