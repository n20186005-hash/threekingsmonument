---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const s = messages.sourceSection;
const mapsUrl = siteConfig.mapsUrl;
const govtUrl = siteConfig.govtTourismUrl;
---

<!-- SourcesSection — E-E-A-T / 资料来源区块 -->
<section id="sources" class="py-20 bg-teak text-ivory border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/80">{s.intro}</p>

    <div class="grid md:grid-cols-3 gap-6 mt-10">
      <!-- Authoritative sources -->
      <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
        <h3 class="font-display text-xl text-goldBright mb-4">{s.officialTitle}</h3>
        <ul class="space-y-4 text-sm">
          {siteConfig.sources.map((src) => (
            <li class="border-l-2 border-gold/40 pl-3">
              <a
                href={src.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-goldBright hover:underline inline-flex items-center gap-1 font-medium"
              >
                {src.name[lang]} <span class="text-ivory/40">↗</span>
              </a>
              <div class="text-ivory/60 mt-0.5">{src.note[lang]}</div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Reviews source -->
      <div class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
        <h3 class="font-display text-xl text-goldBright mb-4">{s.reviewTitle}</h3>
        <div class="text-xs uppercase tracking-wider text-gold">{s.reviewSync}</div>
        <p class="text-sm text-ivory/80 mt-3 leading-relaxed">{s.reviewNote}</p>
        <p class="mt-3 text-sm text-ivory/70">
          {siteConfig.rating} ★ · {siteConfig.reviewCount} · Google Maps
        </p>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 bg-gold text-teak font-semibold px-5 py-2.5 rounded-full hover:bg-goldBright transition-colors"
        >
          {s.reviewLink} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Image rights + official tourism portal -->
      <div id="image-rights" class="rounded-2xl bg-teakDeep/60 border border-gold/20 p-6 scroll-mt-24">
        <h3 class="font-display text-xl text-goldBright mb-3">{s.imageRightsTitle}</h3>
        <p class="text-sm text-ivory/80 leading-relaxed">{s.imageRights}</p>
        <p class="text-sm text-ivory/70 leading-relaxed mt-3">{messages.gallery.intro}</p>
        <p class="text-sm text-ivory/70 leading-relaxed mt-2">{messages.gallery.credits}</p>

        <h3 class="font-display text-xl text-goldBright mt-6 mb-3">{s.govtTitle}</h3>
        <p class="text-sm text-ivory/80 leading-relaxed">
          {s.govtNote}{' '}
          <a
            href={govtUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-goldBright hover:underline"
          >
            {s.govtLink}
          </a>.
        </p>
      </div>
    </div>

    <!-- Reference bibliography moved here from the footer, keeping all source detail in one section. -->
    <div class="mt-8 rounded-2xl bg-teakDeep/60 border border-gold/20 p-6">
      <h3 class="font-display text-xl text-goldBright mb-2">{messages.footer.citationsTitle}</h3>
      <p class="text-sm text-ivory/75 mb-5">{messages.footer.citationsNote}</p>
      <ul class="grid md:grid-cols-3 gap-5 text-sm">
        {messages.footer.citations.map((citation) => (
          <li class="border-l-2 border-gold/40 pl-4">
            <div class="font-medium text-ivory">{citation.title}</div>
            <div class="mt-1 text-ivory/65">{citation.meta}</div>
          </li>
        ))}
      </ul>
    </div>
    {messages.footer.transparency && (
      <div class="mt-6 rounded-xl bg-teakDeep/50 border border-gold/20 p-6">
        <h3 class="font-display text-lg text-goldBright mb-2">{messages.footer.transparencyTitle}</h3>
        <p class="text-sm text-ivory/75">{messages.footer.transparency}</p>
      </div>
    )}
  </div>
</section>
