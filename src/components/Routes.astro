---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.routes;
---

<section id="routes" class="py-20 bg-ivoryDim text-ink border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/85">{s.intro}</p>

    <div class="mt-10 text-xs uppercase tracking-widest text-gold">{s.audienceLabel}</div>

    <div class="grid lg:grid-cols-3 gap-6 mt-4">
      {
        s.audiences.map((audience: any) => (
          <div class="flex flex-col rounded-2xl border border-gold/30 bg-white/55 p-6">
            <div class="text-xs uppercase tracking-wider text-gold">{audience.tag}</div>
            <h3 class="mt-1 font-display text-xl text-teak">{audience.name}</h3>

            <div class="mt-3 flex flex-wrap gap-2">
              <span class="chip text-ink/75">{audience.duration}</span>
              <span class="chip text-ink/75">{audience.pace}</span>
            </div>

            <ol class="mt-5 flex-1 space-y-3 text-sm text-ink/80">
              {audience.steps.map((step: string, index: number) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teak text-[11px] font-semibold text-goldBright">
                    {index + 1}
                  </span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>

            <p class="mt-5 border-t border-gold/25 pt-4 text-xs text-ink/70">{audience.tips}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-16 font-display font-semibold text-2xl md:text-3xl text-teak">{s.plansTitle}</h3>
    <p class="mt-3 max-w-3xl text-ink/80">{s.plansIntro}</p>

    <div class="grid lg:grid-cols-2 gap-6 mt-8">
      {
        s.plans.map((plan: any) => (
          <div class="rounded-2xl border border-gold/30 bg-white/55 p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h4 class="font-display text-xl text-teak">{plan.name}</h4>
              <span class="text-xs uppercase tracking-wider text-gold">{plan.total}</span>
            </div>
            <p class="mt-2 text-sm text-ink/75">{plan.summary}</p>

            <ol class="mt-5 space-y-4">
              {plan.items.map((item: any) => (
                <li class="grid grid-cols-[3.5rem_1fr] gap-4">
                  <span class="font-display text-gold">{item.time}</span>
                  <span>
                    <span class="block text-sm font-medium text-teak">{item.title}</span>
                    <span class="block text-sm text-ink/70">{item.desc}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
