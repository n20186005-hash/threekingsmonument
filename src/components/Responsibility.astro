---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const r = messages.responsibility;
---

<section id="responsibility" class="py-20 bg-ivoryDim text-ink border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{r.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{r.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/85">{r.intro}</p>

    <div class="grid lg:grid-cols-2 gap-10 mt-12">
      <div>
        <h3 class="font-display font-semibold text-2xl text-teak">{r.scienceTitle}</h3>
        <ul class="mt-5 space-y-4">
          {
            r.science.map((paragraph: string) => (
              <li class="flex gap-3 text-ink/80">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                <span class="leading-relaxed">{paragraph}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 rounded-2xl border border-gold/35 bg-gold/10 p-5">
          <div class="text-xs uppercase tracking-widest text-gold">{r.pledgeTitle}</div>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">{r.pledge}</p>
        </div>
      </div>

      <div>
        <h3 class="font-display font-semibold text-2xl text-teak">{r.groupsTitle}</h3>
        <div class="mt-5 space-y-6">
          {
            r.groups.map((group: any) => (
              <div class="rounded-2xl border border-gold/30 bg-white/55 p-5">
                <h4 class="font-display text-lg text-burgundy">{group.title}</h4>
                <ul class="mt-3 space-y-2.5">
                  {group.items.map((item: string) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-ink/80">
                      <span class="text-gold" aria-hidden="true">
                        —
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
