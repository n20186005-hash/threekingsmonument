---
import { languagesList, getI18n } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;
export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = await getI18n(Astro.url);
const title = messages.responsibility.pledgeTitle;
const policy = messages.responsibility.pledge;
const backLabel = { th: 'กลับไปยังแหล่งข้อมูล', en: 'Back to sources', zh: '返回资料来源' }[lang];
---

<BaseLayout lang={lang} title={`${title} | ${messages.meta.title}`} description={policy}>
  <Header lang={lang} messages={messages} />
  <main class="min-h-[65vh] bg-ivory text-ink pt-28 pb-20">
    <article class="max-w-3xl mx-auto px-5">
      <p class="font-hand text-gold text-xl md:text-2xl">{messages.sourceSection.label}</p>
      <h1 class="font-display text-3xl md:text-5xl text-teak mt-2">{title}</h1>
      <div class="mt-8 rounded-2xl border border-gold/30 bg-white/70 p-6 md:p-9">
        <p class="text-base md:text-lg leading-relaxed text-ink/85">{policy}</p>
      </div>
      <a href={`/${lang}/sources/`} class="inline-block mt-8 text-teak font-medium underline underline-offset-4 hover:text-gold">{backLabel} →</a>
    </article>
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
