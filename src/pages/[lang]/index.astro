---
import { getI18n, defaultLang, languagesList } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
import { getWeather } from '../../lib/weather';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Essentials from '../../components/Essentials.astro';
import Weather from '../../components/Weather.astro';
import SundayStatus from '../../components/SundayStatus.astro';
import About from '../../components/About.astro';
import Stories from '../../components/Stories.astro';
import History from '../../components/History.astro';
import Landmarks from '../../components/Landmarks.astro';
import Seasons from '../../components/Seasons.astro';
import Routes from '../../components/Routes.astro';
import Guide from '../../components/Guide.astro';
import Facilities from '../../components/Facilities.astro';
import Food from '../../components/Food.astro';
import Responsibility from '../../components/Responsibility.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import MapSection from '../../components/MapSection.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import Footer from '../../components/Footer.astro';
import { expansion } from '../../data/expansion';

const requested = Astro.params.lang;
if (!requested || !languagesList.includes(requested as Lang)) {
  return Astro.redirect(`/${defaultLang}/`, 302);
}

const { lang, messages } = await getI18n(Astro.url);
// English-only deep-dive sub-pages (history / visiting-guide / nearby-attractions).
const topics = lang === 'en' ? (messages as any).topics : null;
const nearbyHeading = {th:'เที่ยวชมสถานที่ใกล้อนุสาวรีย์สามกษัตริย์',en:'Explore nearby Chiang Mai attractions',zh:'探索三王纪念碑周边景点'}[lang];
const nearbyIntro = {th:'พิพิธภัณฑ์ วัด และสถานที่สำคัญในเมืองเก่า พร้อมข้อมูลการเดินทางเฉพาะแห่ง',en:'Museums, temples and historic places around the Old City, each with its own route and map.',zh:'精选古城博物馆、寺庙与历史景点，查看独立游览路线和地图。'}[lang];
const nearbyLabels: Record<string, [string,string,string]> = {
  'chiang-mai-city-arts-cultural-centre':['หอศิลปวัฒนธรรมเมืองเชียงใหม่','Chiang Mai City Arts & Cultural Centre','清迈城市艺术文化中心'],
  'lanna-folklife-museum':['หอพื้นถิ่นล้านนา','Lanna Folklife Museum','兰纳民俗博物馆'],
  'wat-chedi-luang':['วัดเจดีย์หลวง','Wat Chedi Luang','契迪龙寺'],
  'wat-phra-singh':['วัดพระสิงห์','Wat Phra Singh','帕辛寺'],
  'tha-phae-gate':['ประตูท่าแพ','Tha Phae Gate','塔佩门'],
  'wat-chiang-man':['วัดเชียงมั่น','Wat Chiang Man','清曼寺'],
};
const nearbyPicks = expansion.filter(item => item.slug in nearbyLabels);

// One snapshot per request, shared by the hero strip and the forecast section.
const weather = await getWeather();
---

<BaseLayout
  lang={lang}
  title={messages.meta.title}
  description={messages.meta.description}
  schemaDescription={messages.meta.schemaDescription}
  faqs={messages.guide.faqs}
>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} weather={weather} />
    <section aria-label={lang === 'zh' ? '三十二篇旅游专题入口' : lang === 'th' ? 'ทางเข้าคู่มือท่องเที่ยว 32 เรื่อง' : '32 travel guides'} class="bg-teakDeep border-t border-gold/25">
      <div class="max-w-7xl mx-auto px-5 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="font-display text-xl md:text-2xl text-goldBright">{lang === 'zh' ? '清迈古城 · 32 篇深度专题' : lang === 'th' ? 'เมืองเก่าเชียงใหม่ · คู่มือเจาะลึก 32 เรื่อง' : 'Chiang Mai Old City · 32 In-depth Guides'}</h2>
          <p class="text-sm text-ivory/75 mt-1">{lang === 'zh' ? '周边景点、历史文化、交通路线与实用旅行建议。' : lang === 'th' ? 'สถานที่ใกล้เคียง ประวัติศาสตร์ เส้นทาง และคำแนะนำเที่ยว' : 'Nearby places, history, walking routes and practical travel tips.'}</p>
        </div>
        <a href={`/${lang}/explore/`} class="inline-flex shrink-0 items-center justify-center rounded-full bg-gold px-6 py-3 font-semibold text-teak hover:bg-goldBright transition-colors">{lang === 'zh' ? '查看全部 32 篇专题 →' : lang === 'th' ? 'ดูคู่มือทั้งหมด 32 เรื่อง →' : 'Explore all 32 guides →'}</a>
      </div>
    </section>
    <Essentials messages={messages} />
    <SundayStatus messages={messages} />
    <About messages={messages} />
    <Stories messages={messages} />
    <Weather lang={lang} messages={messages} weather={weather} />
    <History messages={messages} />
    <Landmarks lang={lang} messages={messages} />
    <Seasons messages={messages} />
    <Routes messages={messages} />
    <Guide messages={messages} />
    {topics && (
      <section id="guides" class="guides-band">
        <div class="guides-inner">
          <h2>{topics.linksHeading}</h2>
          <ul class="guides-grid">
            <li>
              <a href="/en/history/"><strong>{topics.history.h1}</strong><span>{topics.history.intro}</span></a>
            </li>
            <li>
              <a href="/en/visiting-guide/"><strong>{topics.visitingGuide.h1}</strong><span>{topics.visitingGuide.intro}</span></a>
            </li>
            <li>
              <a href="/en/nearby-attractions/"><strong>{topics.nearbyAttractions.h1}</strong><span>{topics.nearbyAttractions.intro}</span></a>
            </li>
            <li>
              <a href="/en/explore/"><strong>Explore 32 Old City guides</strong><span>Nearby museums, temples, markets, heritage walks and practical visitor plans.</span></a>
            </li>
          </ul>
        </div>
      </section>
    )}
    <section class="guides-band" aria-labelledby="nearby-heading">
      <div class="guides-inner">
        <h2 id="nearby-heading">{nearbyHeading}</h2>
        <p class="mb-6 text-slate-600">{nearbyIntro}</p>
        <ul class="guides-grid">
          {nearbyPicks.map(item => <li>
            <a href={`/${lang}/explore/${item.slug}/`} hreflang={lang}>
              <strong>{nearbyLabels[item.slug][lang === 'th' ? 0 : lang === 'zh' ? 2 : 1]}</strong>
              <span>{lang === 'en' ? item.summary : lang === 'th' ? 'ดูข้อมูลสถานที่ เส้นทาง และแผนที่' : '查看景点历史、路线及地图'}</span>
            </a>
          </li>)}
        </ul>
        <p class="mt-5"><a class="underline text-amber-800 font-semibold" href={`/${lang}/explore/`}>{lang === 'th' ? 'ดูคู่มือทั้งหมด 32 เรื่อง' : lang === 'zh' ? '查看全部 32 篇攻略' : 'View all 32 guides →'}</a></p>
      </div>
    </section>
    <Facilities messages={messages} />
    <Food lang={lang} messages={messages} />
    <Responsibility messages={messages} />
    <Gallery lang={lang} messages={messages} />
    <Reviews messages={messages} />
    <MapSection lang={lang} messages={messages} />
    <SourcesSection lang={lang} messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />

  <style>
    .guides-band {
      background: var(--surface, #f6f7f9);
      border-top: 1px solid var(--border, #e7e7ea);
      padding: 2.5rem 0;
    }
    .guides-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .guides-band h2 {
      font-size: 1.4rem;
      margin: 0 0 1.25rem;
      color: var(--text, #1f2430);
    }
    .guides-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.1rem;
    }
    .guides-grid a {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      height: 100%;
      padding: 1.2rem;
      border: 1px solid var(--border, #e7e7ea);
      border-radius: 14px;
      background: var(--card, #fff);
      text-decoration: none;
      color: var(--text, #1f2430);
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .guides-grid a:hover {
      border-color: var(--accent, #b45309);
      transform: translateY(-2px);
    }
    .guides-grid strong {
      font-size: 1.05rem;
      color: var(--accent, #b45309);
    }
    .guides-grid span {
      font-size: 0.9rem;
      color: var(--muted, #6b7280);
      line-height: 1.6;
    }
    @media (max-width: 820px) {
      .guides-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
